# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- Django ---------------------------------------------------------
DJANGO_SECRET_KEY=change-me-before-anything-leaves-your-laptop
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ----------------------------------------------------------
MYSQL_DB=esquared_academy
MYSQL_USER=esquared
MYSQL_PASSWORD=
MYSQL_HOST=127.0.0.1
MYSQL_PORT=3306
MYSQL_CONN_MAX_AGE=60
MYSQL_CONNECT_TIMEOUT=10

# --- First superuser -------------------------------------------------
# Migration 0002 creates a superuser on a fresh database so you can log
# into /admin/ immediately. Defaults to admin / admin — change these
# before the database is reachable by anyone but you, or set
# DJANGO_BOOTSTRAP_ADMIN=false and use `manage.py createsuperuser`.
DJANGO_BOOTSTRAP_ADMIN=true
DJANGO_BOOTSTRAP_ADMIN_USERNAME=admin
DJANGO_BOOTSTRAP_ADMIN_PASSWORD=admin
DJANGO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Testing --------------------------------------------------------
# `manage.py test` uses an in-memory SQLite database by default.
# Set this to true to run the suite against MySQL instead — do that in
# CI: SQLite is lenient about column types and ignores CHECK constraints.
DJANGO_TEST_ON_MYSQL=false
