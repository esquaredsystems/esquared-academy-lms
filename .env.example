# Copy to .env and fill in. .env is git-ignored; this file is not.

# --- Django ---------------------------------------------------------
DJANGO_SECRET_KEY=change-me-before-anything-leaves-your-laptop
DJANGO_DEBUG=true
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# --- MySQL ----------------------------------------------------------
MYSQL_DB=esquared_lms
MYSQL_USER=root
MYSQL_PASSWORD=jingle94
MYSQL_HOST=127.0.0.1
# 3307 = the MySQL 8.4 container from docker-compose.yml. 3306 is the old 5.7 server.
MYSQL_PORT=3307
MYSQL_CONN_MAX_AGE=60
MYSQL_CONNECT_TIMEOUT=10

DJANGO_BOOTSTRAP_ADMIN=true
DJANGO_BOOTSTRAP_ADMIN_USERNAME=admin
DJANGO_BOOTSTRAP_ADMIN_PASSWORD=admin
DJANGO_BOOTSTRAP_ADMIN_EMAIL=admin@example.com

# --- Files -----------------------------------------------------------
# Root directory for uploads. Holds text/ audio/ video/ picture/ other/
# and _incoming/. Defaults to <project>/media.
MEDIA_ROOT=
MEDIA_URL=/media/
# Bytes the browser uploader sends per chunk (5 MB).
UPLOAD_CHUNK_SIZE=5242880

# --- Admin theme -----------------------------------------------------
# Skins: default, light-violet, light-green, light-blue, light-gray, green.
JET_THEME=light-gray
# Let each user pick their own skin from the admin sidebar (true)
JET_SHOW_THEME_PICKER=false

# --- Testing --------------------------------------------------------
# `manage.py test` uses an in-memory SQLite database by default.
# Set this to true to run the suite against MySQL instead — do that in
# CI: SQLite is lenient about column types and ignores CHECK constraints.
DJANGO_TEST_ON_MYSQL=false
